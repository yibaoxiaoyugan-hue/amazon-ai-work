# ============================================================
# .env.example —— 仅供参考，本应用【不会】自动读取此文件
# ------------------------------------------------------------
# 当前工作台是纯静态单文件应用（index.html），AI 接口配置在
# 应用内「设置 / AI 配置」面板中手动填写，不依赖 .env 注入。
# 此文件仅用于：① 说明可配置项；② 若后续用构建工具/后端
# 包装时，作为环境变量模板使用。
# 请勿把真实密钥写入此文件或提交到 Git。
# ============================================================

# 可选：AI 分析接口地址（不填则使用内置本地数据引擎，全部离线运行）
# 例：https://api.openai.com/v1/chat/completions
AI_ENDPOINT=

# 可选：AI 接口鉴权 Key（Bearer Token）。仅在你自己的账号下填写，
# 且不要提交真实值；建议通过部署平台的环境变量注入。
AI_API_KEY=

# 可选：模型名（默认 gpt-4o-mini 或你服务端支持的模型）
AI_MODEL=
